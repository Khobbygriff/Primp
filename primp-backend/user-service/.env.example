# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Database name
USER_DB_NAME=primp_users_db

# Service port
USER_SERVICE_PORT=8081

# Service URLs (update for deployment)
USER_SERVICE_URL=http://127.0.0.1:8081
BOOKING_SERVICE_URL=http://127.0.0.1:8082
REVIEW_SERVICE_URL=http://127.0.0.1:8083
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8084

# JWT — use a strong random string in production
JWT_SECRET=your_jwt_secret_key_must_be_at_least_256_bits_long

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Internal service-to-service trust secret — must be identical across gateway
# and every downstream service. Generate a real random value for any deployed
# environment; the fallback used in each service's application.properties is
# dev-only and must never be used in production. Every downstream service
# rejects any request that doesn't carry this exact value in the
# X-Internal-Secret header, which is how they enforce that all traffic comes
# through the gateway rather than hitting their ports directly.
INTERNAL_SERVICE_SECRET=your_internal_service_secret_min_32_chars

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx